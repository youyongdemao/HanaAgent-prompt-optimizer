{
  "manifestVersion": 2,
  "id": "prompt-optimizer",
  "name": "提示词优化",
  "version": "1.0.0",
  "entry": "index.js",
  "icon": "assets/icon.png",
  "description": "把随手写下的基础提示词一键重写成更符合模型直觉的结构化提示词。支持通用、编程、写作、图像、分析、Agent 六种场景。",
  "minAppVersion": "0.1013.0",
  "capabilities": [
    "app/tools.expose-to-model",
    "app/models.infer",
    "app/ui.clipboard-write",
    "app/ui.open-external",
    "app/input.panels",
    "app/input.status",
    "app/hooks.observe"
  ],
  "network": {
    "allowedHosts": [
      "api.github.com"
    ],
    "methods": [
      "GET"
    ],
    "defaultTimeoutMs": 15000,
    "maxResponseBytes": 4194304
  },
  "contributes": {
    "ui": {
      "inputStatus": [
        {
          "id": "open",
          "title": "在输入框上方打开提示词优化面板",
          "icon": "sync",
          "toolName": "open_optimizer_panel"
        }
      ]
    },
    "cards": [
      {
        "id": "panel",
        "title": "提示词优化",
        "description": "写一段粗糙的基础提示词，按场景重写成结构清晰、模型更好执行的高质量提示词。",
        "route": "/card.html",
        "cardForm": "flush",
        "titlebar": "translucent",
        "face": {
          "image": "assets/cover.webp"
        }
      }
    ],
    "settings": {
      "title": "提示词优化",
      "ui": {
        "route": "/settings.html"
      }
    }
  }
}
